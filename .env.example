# ==================================
# ReliefSync Environment Variables
# ==================================
# Copy this file to .env.local and update with your actual values
# NEVER commit .env.local to version control!

# ==================================
# DATABASE (REQUIRED)
# ==================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://postgres:password@localhost:5432/reliefdb?schema=public

# For Docker Compose, use service name as host:
# DATABASE_URL=postgresql://postgres:password@db:5432/reliefdb?schema=public

# ==================================
# JWT SECRET (REQUIRED)
# ==================================
# Secret key for signing JWT tokens
# MUST be at least 32 characters long
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars-REPLACE-ME

# ==================================
# REDIS (OPTIONAL)
# ==================================
# Redis connection string for caching
# If not provided, app will run without caching
# Format: redis://[host]:[port]
REDIS_URL=redis://localhost:6379

# For Docker Compose:
# REDIS_URL=redis://redis:6379

# ==================================
# APPLICATION
# ==================================
# Application name (used for cache prefixes)
APP_NAME=ReliefSync

# Node environment (development, production, test)
NODE_ENV=development

# ==================================
# OPTIONAL PUBLIC VARIABLES
# ==================================
# These are embedded in the client bundle (use NEXT_PUBLIC_ prefix)
# Only add non-sensitive configuration here
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_APP_NAME=ReliefSync
